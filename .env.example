# Copy to .env and fill in. NEVER commit real secrets.
DSDVC_ENV=local
DATABASE_URL=sqlite:///./dsdvc.db
# DATABASE_URL=postgresql+psycopg://dsdvc:dsdvc@db:5432/dsdvc
REDIS_URL=
MLFLOW_TRACKING_URI=
S3_ENDPOINT_URL=
S3_BUCKET=
DSDVC_SECRET_KEY=change-me
# First admin key, format dsdvc_<prefix>_<secret>; generate with: make admin-key
DSDVC_BOOTSTRAP_ADMIN_KEY=
DSDVC_ALLOW_SYNTHETIC=true

# Official platform APIs (only for accounts/pages you are authorised to use)
META_GRAPH_API_VERSION=v26.0
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional web search provider for the research agent
BRAVE_SEARCH_API_KEY=
# Optional LLM narration (report prose only; numbers always come from models)
ANTHROPIC_API_KEY=
DSDVC_LLM_MODEL=claude-opus-5-5

# --- Paid media & commerce connectors (see docs/CONNECTORS.md)
META_AD_ACCOUNT_ID=
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
GA4_SERVICE_ACCOUNT_JSON=
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
