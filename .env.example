# Copy to .env and fill in. NEVER commit real secrets.
DSDVC_ENV=local
DATABASE_URL=sqlite:///./dsdvc.db
# DATABASE_URL=postgresql+psycopg://dsdvc:dsdvc@db:5432/dsdvc
REDIS_URL=
MLFLOW_TRACKING_URI=
# Dataset object storage (docs/DEPLOYMENT.md). Empty S3_BUCKET = local disk (DSDVC_DATA_DIR), not durable in containers.
# S3_ENDPOINT_URL: empty for AWS; https://<account>.r2.cloudflarestorage.com (R2); https://storage.googleapis.com (GCS)
# S3_REGION: e.g. ap-south-1, or "auto" for R2.  S3_PREFIX: optional key prefix, e.g. prod
# S3_SSE: AES256 (default) | aws:kms (with S3_KMS_KEY_ID) | none (provider encrypts by default)
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY); omit to use an IAM role
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_PREFIX=
S3_SSE=AES256
S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DSDVC_SECRET_KEY=change-me
# First admin key, format dsdvc_<prefix>_<secret>; generate with: make admin-key
DSDVC_BOOTSTRAP_ADMIN_KEY=
DSDVC_ALLOW_SYNTHETIC=true

# Official platform APIs (only for accounts/pages you are authorised to use)
META_GRAPH_API_VERSION=v26.0
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional web search provider for the research agent
BRAVE_SEARCH_API_KEY=
# Optional LLM narration (report prose only; numbers always come from models)
ANTHROPIC_API_KEY=
DSDVC_LLM_MODEL=claude-opus-5-5

# --- Paid media & commerce connectors (see docs/CONNECTORS.md)
META_AD_ACCOUNT_ID=
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
GA4_SERVICE_ACCOUNT_JSON=
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# --- Sign-in & tenancy (see docs/SECURITY_AND_TENANCY.md)
DSDVC_PUBLIC_URL=http://localhost:8000
DSDVC_OIDC_PROVIDERS=
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
DSDVC_SESSION_HOURS=12
DSDVC_SINGLE_TENANT=false
# Local development only - never in production:
DSDVC_ALLOW_UNAUTHENTICATED=false
# Per-client connector credentials use the workspace slug, e.g.
# WS_ACME_META_ACCESS_TOKEN=  WS_ACME_META_AD_ACCOUNT_ID=  WS_ACME_SHOPIFY_SHOP=
